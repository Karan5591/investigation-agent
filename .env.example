# Copy this file to .env and fill in your own values. Never commit .env.

# --- Local LLM (Ollama OpenAI-compatible API) ---
# No API key is needed for Ollama. The client supplies a placeholder if this is blank.
OPENAI_API_KEY=
OPENAI_MODEL=qwen2.5:7b
OPENAI_BASE_URL=http://localhost:11434/v1

# --- Elasticsearch ---
ES_URL=http://localhost:9200
ES_INDEX=document_chunks
ES_ENABLED=true

# --- SQLite ---
SQLITE_PATH=data/app.db

# --- Embeddings + reranker (local, via sentence-transformers) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
RERANKER_MODEL=BAAI/bge-reranker-base

# --- OCR ---
OCR_LANG=eng
OCR_MIN_CONFIDENCE=70

# --- Agent guards ---
AGENT_MAX_STEPS=8
AGENT_MAX_REPEATED_CALLS=2
LLM_REPAIR_RETRIES=1
PROCESSING_STALE_SECONDS=300

# --- Storage ---
UPLOAD_DIR=data/uploads
